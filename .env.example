# ============================================================
# Unravel — variables de entorno
# Copia este archivo a ".env" en la raíz del repo y completa
# los valores. Docker Compose lo carga automáticamente.
# ============================================================

# --- Base de datos ---
POSTGRES_USER=unravel
POSTGRES_PASSWORD=unravel
POSTGRES_DB=unravel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unravel:unravel@db:5432/unravel

# --- Cola / cache ---
REDIS_URL=redis://redis:6379/0

# --- LLM (compatible con API estilo OpenAI/OpenRouter) ---
# Funciona con cualquier proveedor compatible con el formato de chat
# completions de OpenAI. Por defecto usa NVIDIA NIM (https://build.nvidia.com)
# porque el pool gratuito compartido de OpenRouter suele saturarse.
# Generá una API key gratis en build.nvidia.com (empieza con "nvapi-")
# y pegala abajo. También podés usar OpenRouter (https://openrouter.ai)
# cambiando OPENROUTER_BASE_URL a https://openrouter.ai/api/v1 y el modelo
# a uno de los ":free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
# Requeridos por OpenRouter para atribuir tráfico de la app (opcionales, se ignoran con otros proveedores)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Unravel

# --- Discovery (todas estas fuentes son gratuitas y no requieren key) ---
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
SEARCH_MAX_RESULTS=20
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_SOURCES=30

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
