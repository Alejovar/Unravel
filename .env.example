# ============================================================
# Unravel — environment variables
# Copy this file to ".env" in the repository root and fill in
# the values. Docker Compose loads it automatically.
# ============================================================

# --- Database ---
POSTGRES_USER=unravel
POSTGRES_PASSWORD=unravel
POSTGRES_DB=unravel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unravel:unravel@db:5432/unravel

# --- Queue / cache ---
REDIS_URL=redis://redis:6379/0

# --- LLM (OpenAI/OpenRouter-style API) ---
# Works with any provider compatible with the OpenAI chat completions
# format. It defaults to NVIDIA NIM (https://build.nvidia.com) because the
# shared free pool on OpenRouter tends to be saturated. Generate a free API
# key at build.nvidia.com (it starts with "nvapi-") and paste it below. You
# can also use OpenRouter (https://openrouter.ai) by setting
# OPENROUTER_BASE_URL to https://openrouter.ai/api/v1 and picking one of
# the ":free" models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://integrate.api.nvidia.com/v1
# Required by OpenRouter to attribute app traffic (optional, ignored by other providers)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Unravel

# --- Discovery (all of these sources are free and need no key) ---
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
SEARCH_MAX_RESULTS=20
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_SOURCES=30

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
