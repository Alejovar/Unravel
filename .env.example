# ============================================================
# Unravel — variables de entorno
# Copia este archivo a ".env" en la raíz del repo y completa
# los valores. Docker Compose lo carga automáticamente.
# ============================================================

# --- Base de datos ---
POSTGRES_USER=unravel
POSTGRES_PASSWORD=unravel
POSTGRES_DB=unravel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://unravel:unravel@db:5432/unravel

# --- Cola / cache ---
REDIS_URL=redis://redis:6379/0

# --- LLM (OpenRouter) ---
# Único proveedor de modelo de lenguaje usado por el proyecto.
# Crea una cuenta gratuita en https://openrouter.ai, genera una
# API key y pégala aquí. Deja el modelo en uno de los ":free"
# de OpenRouter para no incurrir en costo.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Requeridos por OpenRouter para atribuir tráfico de la app (opcionales pero recomendados)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Unravel

# --- Discovery (todas estas fuentes son gratuitas y no requieren key) ---
GDELT_DOC_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
SEARCH_MAX_RESULTS=20
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_SOURCES=30

# --- Backend ---
BACKEND_CORS_ORIGINS=http://localhost:3000
ENV=development

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
